#!/bin/bash

set -eu

TEST_RPMS="${TEST_RPMS:-}"
TEST_OS="${TEST_OS:-fedora-rawhide-boot}"
BUILD_RPMS_IMAGE="${TEST_OS/\-boot/}"

# Copy the extra RPMs to the tmp/rpms directory
for i in ${TEST_RPMS//,/ }; do
    echo "Copying $i to tmp/rpms"
    cp $i tmp/rpms
done

rm -rf updates updates.img

make install DESTDIR="$(pwd)/updates"

cd updates && for rpm in ../tmp/rpms/*.rpm; do rpm2cpio "$rpm" | cpio -idmu 2>/dev/null; done

find . | cpio -c -o 2>/dev/null | gzip -9 > ../updates.img
cd ..
rm -rf updates

cp updates.img "updates-${BUILD_RPMS_IMAGE}.img"
