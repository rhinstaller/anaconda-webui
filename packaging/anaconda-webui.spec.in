Name:           anaconda-webui
Version:        %{VERSION}
Release:        1%{?dist}
Summary:        Anaconda installer Web interface
License:        LGPL-2.1-or-later AND MIT
URL:            https://github.com/rhinstaller/%{name}

# distributions which ship nodejs-esbuild can rebuild the bundle during package build
%if 0%{?fedora} >= 42
%define rebuild_bundle 1
%endif

Source0:        https://github.com/rhinstaller/%{name}/releases/download/%{version}/%{name}-%{version}.tar.xz
%if %{defined rebuild_bundle}
Source1:        https://github.com/rhinstaller/%{name}/releases/download/%{version}/%{name}-node-%{version}.tar.xz
%endif
BuildArch:      noarch
BuildRequires:  libappstream-glib
BuildRequires:  make
BuildRequires:  gettext
BuildRequires:  python3
# Needed for the unitdir macro
BuildRequires: systemd-rpm-macros

%if %{defined rebuild_bundle}
BuildRequires:  /usr/bin/node
BuildRequires:  nodejs-esbuild
%endif

%global anacondacorever 0

%if 0%{?fedora} > 41
%global anacondacorever 42.5
%endif

%global cockpitver 275

%define _unitdir /usr/lib/systemd/system

Requires: cockpit-storaged
Requires: cockpit-networkmanager
Requires: cockpit-bridge >= %{cockpitver}
Requires: cockpit-ws >= %{cockpitver}
Requires: anaconda-core  >= %{anacondacorever}
Requires: python3-bugzilla
Requires: %{name}-opener
Requires: %{name}-browser-ext = %{version}-%{release}
# Downstreams using Flatpak browsers on RHEL supply their own provider.
%if ! 0%{?rhel}
Suggests: %{name}-opener-firefox
%endif
%if 0%{?fedora}
Requires: system-logos
%endif
BuildRequires: desktop-file-utils

%{NPM_PROVIDES}

%description
Anaconda installer Web interface

%package opener-firefox
Summary: Firefox launcher for the Anaconda installer Web interface
Requires: firefox
Provides: %{name}-opener
Conflicts: %{name}-opener

%description opener-firefox
Launch the Anaconda installer Web interface in a separate Firefox instance
with an installer-specific profile.

%package browser-ext
Summary: External link handler for the Anaconda installer Web interface
Requires: xdg-utils

%description browser-ext
Open external links from the installer in the desktop's preferred browser.
Includes a separate Firefox profile for external links, independently of the
browser used by the installer opener.

%prep
%setup -q -n %{name}
%if %{defined rebuild_bundle}
%setup -q -D -T -a 1 -n %{name}
%endif

%build
%if %{defined rebuild_bundle}
rm -rf dist
NODE_ENV=production NODE_PATH=/usr/lib/node_modules ./build.js
%else
# Use pre-built bundle on distributions without nodejs-esbuild
%endif

%install
%make_install PREFIX=/usr

desktop-file-install --dir=%{buildroot}%{_datadir}/applications %{buildroot}%{_datadir}/applications/extlinks.desktop
desktop-file-install --dir=%{buildroot}%{_datadir}/applications %{buildroot}%{_datadir}/applications/anaconda-gnome-control-center.desktop

%check
%make_build check

%files
%dir %{_datadir}/cockpit/anaconda-webui
%doc README.rst
%license LICENSE dist/index.js.LEGAL.txt dist/anacondaLogin.js.LEGAL.txt
%{_datadir}/cockpit/anaconda-webui/login.html
%{_datadir}/cockpit/anaconda-webui/anacondaLogin.js
%{_datadir}/cockpit/anaconda-webui/anacondaLogin.js.map
%{_datadir}/cockpit/anaconda-webui/anacondaLogin.js.LEGAL.txt
%{_datadir}/cockpit/anaconda-webui/anacondaLogin.css
%{_datadir}/cockpit/anaconda-webui/anacondaLogin.css.map
%{_datadir}/cockpit/anaconda-webui/qr-code-feedback.svg
%{_datadir}/cockpit/anaconda-webui/index.js.LEGAL.txt
%{_datadir}/cockpit/anaconda-webui/index.html
%{_datadir}/cockpit/anaconda-webui/index.js.gz
%{_datadir}/cockpit/anaconda-webui/index.js.map
%{_datadir}/cockpit/anaconda-webui/index.css.gz
%{_datadir}/cockpit/anaconda-webui/index.css.map
%{_datadir}/cockpit/anaconda-webui/manifest.json
%{_datadir}/cockpit/anaconda-webui/po.*.js.gz
%{_datadir}/cockpit/anaconda-webui/VERSION.txt
%{_libexecdir}/anaconda/cockpit-coproc-wrapper.sh
%{_libexecdir}/anaconda/anaconda-cockpit-conf-merge
%dir /etc/anaconda/cockpit
%config(noreplace) /etc/anaconda/cockpit/cockpit.conf
%dir /etc/anaconda/cockpit/conf.d
%dir %{_datadir}/anaconda/cockpit
%dir %{_datadir}/anaconda/cockpit/conf.d
%{_datadir}/anaconda/cockpit/conf.d/50-remote-auth.conf
%{_libexecdir}/anaconda/cockpit-pin-auth
%{_libexecdir}/anaconda/webui-desktop
%{_libexecdir}/anaconda/gnome-control-center-ext
%{_datadir}/applications/anaconda-gnome-control-center.desktop
%{_unitdir}/webui-cockpit-ws.service
%{_unitdir}/cockpit-pin-auth.socket
%{_unitdir}/cockpit-pin-auth@.service
%{_unitdir}/webui-tls-proxy.service
%{_libexecdir}/anaconda/webui-tls-proxy

%files opener-firefox
%license LICENSE
%{_bindir}/anaconda-webui-opener
%dir %{_datadir}/anaconda/firefox-theme
%{_datadir}/anaconda/firefox-theme/default
%{_datadir}/anaconda/firefox-theme/live

%files browser-ext
%license LICENSE
%{_libexecdir}/anaconda/browser-ext
%{_datadir}/applications/extlinks.desktop
%dir %{_datadir}/anaconda/firefox-theme
%{_datadir}/anaconda/firefox-theme/extlink


# The changelog is automatically generated and merged
%changelog
